# ==============================================================================
# SINERGI (nerasync-dashboard) — Templat Variabel Lingkungan (.env.example)
# Salin menjadi .env (lokal saja, jangan pernah di-commit ke Git)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Go (services/api)
# ------------------------------------------------------------------------------
PORT=8080
APP_ENV=development
LOG_LEVEL=info

# PostgreSQL 16 (Neon Serverless) — pisahkan 3 role (ADR-07)
DATABASE_URL_PUBLIC=
DATABASE_URL_WRITER=
DATABASE_URL_MIGRATOR=

# CORS asal frontend yang diizinkan (pisahkan koma)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google Cloud Service Account JSON (read-only Sheets & Drive API)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Token Keamanan Machine-to-Machine (acak >= 32 byte)
INTERNAL_API_TOKEN=
CRON_SECRET=
REVALIDATE_SECRET=

# Webhook On-Demand Revalidation ke Frontend Next.js
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate

# Alert Real-Time Tim IT (Telegram Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Frontend Next.js (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
